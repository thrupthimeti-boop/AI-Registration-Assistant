import json
import re
from pathlib import Path
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression

BASE = Path(__file__).parent

INTENT_DATA = {
    "greeting": [
        "hello", "hi", "hey", "good morning", "good afternoon",
        "start registration", "I want to register"
    ],
    "course_info": [
        "what courses are available", "tell me about courses",
        "which courses can I take", "show me available courses",
        "what programs are offered"
    ],
    "eligibility": [
        "am I eligible", "check my eligibility",
        "can I join this course",
        "what are the eligibility requirements",
        "do I qualify"
    ],
    "registration_guidance": [
        "how do I register",
        "guide me through registration",
        "what is the registration process",
        "steps to register",
        "how can I enroll"
    ],
    "provide_name": [
        "my name is", "I am", "this is"
    ],
    "provide_email": [
        "my email is", "email is", "contact me at"
    ],
    "provide_course": [
        "I want Python",
        "I want Data Science",
        "I want AI",
        "I want to join Python",
        "I want to enroll in data science"
    ],
    "confirm": [
        "yes", "confirm", "I confirm", "correct", "proceed"
    ],
    "cancel": [
        "no", "cancel", "stop", "not now"
    ],
    "help": [
        "help", "what can you do", "options", "support"
    ],
    "goodbye": [
        "bye", "goodbye", "see you"
    ]
}

COURSES = {
    "Python": {
        "min_age": 16,
        "qualification": "10th pass",
        "description": "Python programming fundamentals and practical coding."
    },
    "Data Science": {
        "min_age": 18,
        "qualification": "12th pass",
        "description": "Data analysis, Python, statistics and introductory machine learning."
    },
    "Artificial Intelligence": {
        "min_age": 18,
        "qualification": "12th pass",
        "description": "AI, machine learning and introductory NLP concepts."
    }
}

QUALIFICATION_LEVELS = {
    "10th": 1,
    "10th pass": 1,
    "sslc": 1,
    "12th": 2,
    "12th pass": 2,
    "puc": 2,
    "degree": 3,
    "graduate": 3,
    "graduation": 3
}


class RegistrationAssistant:

    def __init__(self):
        texts = []
        labels = []

        for intent, examples in INTENT_DATA.items():
            for example in examples:
                texts.append(example)
                labels.append(intent)

        self.vectorizer = TfidfVectorizer(
            lowercase=True,
            ngram_range=(1, 2)
        )

        X = self.vectorizer.fit_transform(texts)

        self.model = LogisticRegression(max_iter=1000)
        self.model.fit(X, labels)

        self.state = {
            "name": None,
            "email": None,
            "course": None,
            "age": None,
            "qualification": None
        }

    def predict_intent(self, message):
        X = self.vectorizer.transform([message])
        return self.model.predict(X)[0]

    def extract_entities(self, message):

        entities = {}

        email = re.search(
            r'[\w\.-]+@[\w\.-]+\.\w+',
            message
        )

        if email:
            entities["email"] = email.group(0)

        age = re.search(
            r'\b(?:age\s*(?:is|:)?\s*)?(\d{1,3})\s*(?:years?|yrs?)?\b',
            message,
            re.I
        )

        if age:
            value = int(age.group(1))

            if 10 <= value <= 100:
                entities["age"] = value

        lower = message.lower()

        for course in COURSES:
            if course.lower() in lower:
                entities["course"] = course

        if "python" in lower:
            entities["course"] = "Python"

        elif "data science" in lower:
            entities["course"] = "Data Science"

        elif "artificial intelligence" in lower:
            entities["course"] = "Artificial Intelligence"

        elif re.search(r"\bai\b", lower):
            entities["course"] = "Artificial Intelligence"

        for qualification in sorted(
            QUALIFICATION_LEVELS,
            key=len,
            reverse=True
        ):
            if qualification in lower:
                entities["qualification"] = qualification
                break

        name_match = re.search(
            r"(?:my name is|i am|i'm|name\s*[:\-])\s+"
            r"([A-Za-z][A-Za-z .'-]{1,50})",
            message,
            re.I
        )

        if name_match:
            candidate = name_match.group(1).strip()

            candidate = re.split(
                r"\s+(?:and|my|email|age|course)\b",
                candidate,
                flags=re.I
            )[0].strip()

            if candidate:
                entities["name"] = candidate

        return entities

    def check_eligibility(self):

        course = self.state["course"]

        if not course:
            return (
                "Please tell me which course you want "
                "to check eligibility for."
            )

        info = COURSES[course]

        age = self.state["age"]
        qualification = self.state["qualification"]

        missing = []

        if age is None:
            missing.append("your age")

        if qualification is None:
            missing.append("your highest qualification")

        if missing:
            return (
                "To check eligibility, please provide "
                + " and ".join(missing)
                + "."
            )

        q_level = QUALIFICATION_LEVELS.get(
            qualification,
            0
        )

        required_level = QUALIFICATION_LEVELS[
            info["qualification"]
        ]

        if age < info["min_age"]:
            return (
                f"You are not eligible for {course} yet. "
                f"The minimum age is {info['min_age']}."
            )

        if q_level < required_level:
            return (
                f"You do not currently meet the qualification "
                f"requirement for {course}. "
                f"Required: {info['qualification']}."
            )

        return (
            f"You are eligible for {course}! "
            "Minimum requirements have been satisfied."
        )

    def registration_status(self):

        required = [
            "name",
            "email",
            "course",
            "age",
            "qualification"
        ]

        missing = [
            x for x in required
            if not self.state[x]
        ]

        if missing:

            friendly = {
                "name": "name",
                "email": "email address",
                "course": "course",
                "age": "age",
                "qualification": "highest qualification"
            }

            return (
                "Before registration, please provide: "
                + ", ".join(
                    friendly[x] for x in missing
                )
                + "."
            )

        eligibility = self.check_eligibility()

        if not eligibility.startswith(
            "You are eligible"
        ):
            return eligibility

        data_file = BASE / "registrations.json"

        try:
            registrations = json.loads(
                data_file.read_text()
            )

        except (FileNotFoundError, json.JSONDecodeError):
            registrations = []

        record = dict(self.state)

        registrations.append(record)

        data_file.write_text(
            json.dumps(
                registrations,
                indent=2
            )
        )

        return (
            f"Registration successful for "
            f"{self.state['name']} in "
            f"{self.state['course']}! "
            "Your details have been recorded."
        )

    def respond(self, message):

        entities = self.extract_entities(message)

        self.state.update(entities)

        intent = self.predict_intent(message)

        lower = message.lower()

        if intent == "greeting":
            return (
                "Hello! I am the AI Registration Assistant. "
                "I can help with course information, "
                "eligibility checks, and registration guidance. "
                "What would you like to do?"
            )

        if intent == "course_info":
            return "\n".join(
                f"- {name}: {info['description']} "
                f"(minimum age {info['min_age']}, "
                f"{info['qualification']})"
                for name, info in COURSES.items()
            )

        if intent == "eligibility":
            return self.check_eligibility()

        if intent == "registration_guidance":
            return (
                "Registration steps:\n"
                "1. Select a course.\n"
                "2. Provide your name and email.\n"
                "3. Provide your age and qualification.\n"
                "4. Complete the eligibility check.\n"
                "5. Confirm registration."
            )

        if intent == "help":
            return (
                "I can help you with:\n"
                "• Available courses\n"
                "• Eligibility checks\n"
                "• Registration steps\n"
                "• Collecting registration details\n"
                "Try: 'What courses are available?'"
            )

        if intent == "goodbye":
            return (
                "Goodbye! All the best with your "
                "course registration."
            )

        if intent == "cancel":
            return (
                "Registration cancelled. "
                "You can start again whenever you are ready."
            )

        if intent == "confirm":
            return self.registration_status()

        if entities:

            missing = [
                key for key, value in self.state.items()
                if value is None
            ]

            if not missing:
                return (
                    "I have collected all required details. "
                    "Please type 'yes' to confirm registration "
                    "or 'no' to cancel."
                )

            prompts = {
                "name": "What is your full name?",
                "email": "What is your email address?",
                "course": (
                    "Which course would you like: Python, "
                    "Data Science, or Artificial Intelligence?"
                ),
                "age": "What is your age?",
                "qualification": (
                    "What is your highest qualification?"
                )
            }

            return prompts[missing[0]]

        if "eligible" in lower or "qualify" in lower:
            return self.check_eligibility()

        return (
            "I'm not sure I understood that. "
            "You can ask about courses, eligibility, "
            "registration steps, or provide your "
            "registration details."
        )


if __name__ == "__main__":

    bot = RegistrationAssistant()

    print(
        "AI Registration Assistant. "
        "Type 'bye' to exit."
    )

    while True:

        message = input("You: ")

        if message.lower().strip() == "bye":
            print("Bot: Goodbye!")
            break

        print(
            "Bot:",
            bot.respond(message)
        )
